{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraScreensaver",
  "version": "2.0.0",
  "identifier": "com.ipf-sinon.aura-screensaver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "希沃屏保配置",
        "width": 1000,
        "height": 780,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
