{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraScreensaver",
  "version": "2.2.0",
  "identifier": "com.ipf-sinon.aura-screensaver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "希沃屏保配置",
        "width": 560,
        "height": 520,
        "minWidth": 500,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
